# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# Monaco 本地资源：由 scripts/sync-monaco.mjs 从 node_modules 拷来（predev / prebuild 自动跑）
# 5MB 级的 vendored JS 不入库，与「数据与工具链不入库」同一取向
/public/monaco

# typescript
*.tsbuildinfo
next-env.d.ts
