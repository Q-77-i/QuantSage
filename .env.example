#小石数据源API_KEY
XIAOSHI_API_KEY=""

#DeepSeekAPI_KEY
DEEPSEEK_API_KEY=""

# 上游地址覆盖，空 = 走 provider 默认。只为一个用途存在：可靠性演练要「真杀 LLM」
# 又不碰密钥时，指向 http://127.0.0.1:9 这类不可达端口即可（scripts/drill_reliability.py）
# DEEPSEEK_API_BASE=""

# ── 深度研报多 Agent（M8）：模型档与预算硬上限 ──
# 思考开关。**默认 false（关）**：实测同一条取证 prompt，flash 开 8.99s/2,180 tok、
# 关 0.84s/66 tok；pro 开 107.03s/10,783 tok、关 1.48s/73 tok，且四条正文信息一致（单样本）。
# 深度由「多角色取证 + 对抗辩论 + 证据回链」的结构承担，不由思维链长度承担。
# ⚠ 别用 reasoning_effort="minimal" 代替——实测不生效（12.78s / 2,973 tokens），它照想不误。
RESEARCH_THINKING=false

# 以下都有默认值（见 app/core/config.py），要改才取消注释：
# RESEARCH_FAST_MODEL="deepseek/deepseek-flash"     # 取证 / 路由
# RESEARCH_DEEP_MODEL="deepseek/deepseek-v4-pro"    # 辩论 / 综合
# RESEARCH_ROLE_TIMEOUT=60                          # 单次解读超时（秒）
# 预算四计数器——到限在**节点边界**停，不打断已经发出去的调用
# RESEARCH_MAX_LLM_CALLS=40
# RESEARCH_MAX_TOKENS=200000
# RESEARCH_MAX_SECONDS=300
# RESEARCH_MAX_COST_USD=0.50
# RESEARCH_DEBATE_ROUNDS=2                          # 默认 2，硬上限 3（PRD 要求 ≤3）

# 节点级墙钟兜底：某个取证/辩论节点挂住时的最后一道闸
# ⚠ 命中即**整跑失败**（LangGraph 的节点超时节点内接不住，实测），不是降级路径
# 取值须大于「重试预算 90s + 取数时长」的最坏值，否则它会在重试中途开火
# RESEARCH_NODE_TIMEOUT_SECONDS=120

# ── 限流（E4）：进程内令牌桶，三桶各「容量 / 窗口秒」 ──
# 默认取演示友好档：正常用不会碰到，连打才拦得住。429 带 Retry-After；SSE 端点在开流前就拒
# （回 JSON 而不是一帧 error——首字节发出就改不了状态码）
# RATE_LIMIT_CHAT=10
# RATE_LIMIT_CHAT_WINDOW=60
# RATE_LIMIT_RESEARCH=3
# RATE_LIMIT_RESEARCH_WINDOW=600
# RATE_LIMIT_TASK_SUBMIT=20
# RATE_LIMIT_TASK_SUBMIT_WINDOW=60

# ── 任务队列 v2（S2）：崩溃/租约过期后的有限次重排 ──
# 1 = 只执行一次、不重排；建任务时快照
# TASK_MAX_ATTEMPTS=2
# false = 只保留 SKIP LOCKED（不设租约/不跑 reaper，启动扫尾退回 failed/interrupted）
# TASK_LEASE_ENABLED=true

# ── 用户配额（E2）：**累计用量**，落 Postgres、跨重启（与上面 L0 的「速率」是两件事）──
# 两个维度：在飞任务数（queued + running，**排队即占额**）、每日 Agent 请求数（自然日 +08）。
# **0 = 不限额**；admin 恒不限额。默认「演示友好」：正常用碰不到，灌队列/刷量才拦得住
# QUOTA_ACTIVE_TASKS=3
# QUOTA_AGENT_CALLS_PER_DAY=200

# ── 单轮对话的硬上限（E4）：步数由图自己拦（RECURSION_LIMIT=12），这里是另外三样 ──
# 默认留了十倍量级余量，撞上它们是异常而不是常态；到限会给一句说明并保留已产出的正文
# CHAT_MAX_TOKENS=120000
# CHAT_MAX_SECONDS=180
# CHAT_MAX_COST_USD=0.20

# ── 用户策略沙箱（M4）──
# require（默认）= 没有 sandbox-exec（macOS）/ bwrap（Linux）就拒绝执行用户策略；
# auto = 无沙箱时降级并告警；off = 显式关闭（仅可信环境）。
# 环境变量在所有模式下都会清洗，且子进程不读仓库根 .env。
# STRATEGY_ISOLATION=require

# ── 安全/部署（2026-10-17 收尾加固）──
# MAX_REQUEST_BYTES=1048576          # 请求体硬上限
# RATE_LIMIT_AUTH=10                 # 登录/注册：次/分钟/客户端地址
# SESSION_COOKIE_SECURE=false        # 上线 HTTPS 置 true
# PUBLIC_BASE_URL=                   # 如 https://quantsage.example（能力卡用它，不再回显 Host）
# TRUSTED_HOSTS=["*"]                # 公网部署填真实域名（JSON 数组）
# METRICS_TOKEN=                     # 留空只允许回环 scrape；公网填随机 token
# 定时任务（ETL / 行情刷新 / 数据体检 / 决策结算）只在后台主实例运行；
# 同一库的第二个进程只服务 HTTP。
# MEMORY_SETTLE_ENABLED=false
# MEMORY_SETTLE_HOUR=21
# MEMORY_SETTLE_MINUTE=40

# Langfuse 可观测
LANGFUSE_BASE_URL="http://127.0.0.1:3000"
LANGFUSE_PUBLIC_KEY=""
LANGFUSE_SECRET_KEY=""

# ── 本地基础设施（docker compose 与后端共用同一份 .env）──
POSTGRES_USER=quantsage
POSTGRES_PASSWORD=""
POSTGRES_DB=quantsage
POSTGRES_HOST_PORT=5433
REDIS_HOST_PORT=6379
QDRANT_HTTP_PORT=6333
QDRANT_GRPC_PORT=6334
REDIS_URL="redis://127.0.0.1:6379/0"
QDRANT_URL="http://127.0.0.1:6333"

# ── LangGraph 安全红线（import 期读取；app/__init__.py 另有兜底）──
LANGGRAPH_STRICT_MSGPACK=true

# ── 小石稳定入口（由安装器回填绝对路径，勿手写）──
XIAOSHI_MCP_COMMAND=""
XIAOSHI_CLI_COMMAND=""

# MCP 会话读超时（秒）：工具调用卡住的上限。此前这条路径**完全没有超时**
# （CLI 那条另有 BARS_CALL_TIMEOUT_SECONDS / BARS_REFRESH_BUDGET_SECONDS）
# XIAOSHI_MCP_READ_TIMEOUT_SECONDS=60

# ── 数据接入（M2b）：事件语料日增量 ──
# 默认关：定时任务会对外发请求、写 data/，本地开发与测试不该被它打扰。
# 要让它自己跑就改成 true；手动触发走 POST /api/v1/etl/run，不看这个开关。
ETL_ENABLED=false
ETL_HOUR=21
ETL_MINUTE=10
# 回落窗口（自然日）：吸收迟到事件与平台修订
# （实测 news 的 available_at 相对 event_time 中位滞后 50 分钟、p90 22 小时、14% 跨日才可见）
ETL_TRAILING_DAYS=7
# 启动时对一次缺口（关机/长假后自动对齐；归档保留期是滚动的，缺口拖久了就永久拿不到）
ETL_CATCHUP_ON_START=true
# 语料落定后自动增量补嵌向量索引（拉起 scripts/embed_events.py 子进程）
# 不补的话索引每天落后一天；**失败不改变 ETL 的成败**——索引是派生物，是否落后看体检 X4
ETL_EMBED_AFTER_RUN=false

# ── 行情按需刷新（M2d）：便宜探测 → 按需整片重下 ──
# 行情是年度整片、内容寻址（cn-daily 的源侧维度是 {year, adjust}，没有 date）
# ——没有「增量行情」可拉，所以这里是「按需整片重下」：先问源侧发布标识变没变
# （1 次调用），变了才下；下完按分片 sha 与本地指纹比，全同就不动 data/bars/。
# 默认关。成本实测：日常一个交易日只动当前年 3 片（≈99MB），除权会牵动多年 qfq
# （实测那天换入 9 片 / 395MB / 8.6 分钟），源侧无更新时零下载。
BARS_REFRESH_ENABLED=false
# 21:40：实测源侧发布在 21:05–21:29、语料 job 在 21:10，取两者之后（不与语料撞锁）
BARS_REFRESH_HOUR=21
BARS_REFRESH_MINUTE=40
# 整轮预算（秒）：超了就收工留台账，次日重跑即续（未变分片按 sha 复用，零重复下载）
BARS_REFRESH_BUDGET_SECONDS=1200
# 单次 CLI 调用上限（秒）：**必须有**——实测卡在网络 20 分钟零写入
BARS_CALL_TIMEOUT_SECONDS=300
# 启动补一次（延后 180s，避开语料的 catchup）
BARS_REFRESH_CATCHUP_ON_START=true

# ── 数据体检定时化（E3a）：把 M2c 的脚本级体检挂上调度并落档 ──
# 跑那 23 项只读检查 + 退市核实，结果落 data/_meta/health_runs.jsonl（摘要）
# 与 health_last.json（全文），看板读它们：GET /api/v1/data/health（admin）。
# 默认关。⚠ 它与 ETL_ENABLED 同住一个调度器——总闸关着时这一路也不起。
DATA_HEALTH_ENABLED=false
# 22:10：**必须在两个写通道之后**（语料 21:10、行情 21:40）——早于它们跑，测的是上一版数据。
# 成本实测 5.5s（B1 要逐片重算行情 sha，888MB 是 I/O 大头）；与写通道互斥，撞上就跳过并留痕。
DATA_HEALTH_HOUR=22
DATA_HEALTH_MINUTE=10
# 启动补一次（延后 300s，排在语料 +20s、行情 +180s 之后，三条互斥的活儿不挤一起）
DATA_HEALTH_CATCHUP_ON_START=true

# ── 数据快照（E3b）：清单归档的保留份数。约 170KB/份，20 份 ≈ 3.4MB ──
# 这是回滚能力的深度：更早的快照被滚掉后，即便对象还在 raw/o 里也无从知道当时该还原成什么样
SNAPSHOT_KEEP=20

# ── 数据层缓存（E3c）：L1 进程内 + L2 Redis，键带数据代际 ──
# 默认关。⚠ 开关只管 L2：L1 是进程内记忆化，没有外部依赖、收益还更大（实测 73× vs 12×），
# 关掉它没有任何好处。失效靠键里的代际（_meta 清单一变键就变），TTL 只是兜底不是失效手段。
CACHE_ENABLED=false
CACHE_TTL_SECONDS=900
CACHE_KEY_PREFIX="qs:cache:v1"

# ── RAG（M3）：本地事件语料的嵌入与检索 ──
# 权重目录（bge-m3 与 reranker 各约 2.3GB；放仓库内 .tools/，不入库）
# RAG_MODEL_DIR=
# 设备分两处：嵌入在 CPU 上问答路径只要 0.15s，不必占 MPS 内存；
# 精排是服务端唯一瓶颈（50 篇 3–5s），MPS + fp16 实测快 2.2–3.7 倍且内存不涨。
# 批量嵌入任务（scripts/embed_events.py）只看 RAG_EMBED_DEVICE。
RAG_EMBED_DEVICE=cpu
# auto = 有 MPS 就用 MPS（Apple Silicon）；也可显式写 cpu / mps
RAG_RERANK_DEVICE=auto
# 精排的截断档：候选文本中位 80 字，长尾才是延迟来源（512 → 165ms/篇、256 → 73、128 → 36）
RAG_RERANK_MAX_LENGTH=256
# 启动时后台预热两个模型（约 +4GB 常驻，换首次提问不卡）；本地演示可置 true
RAG_WARMUP_ON_START=false

# ── Langfuse 自托管服务端（仅 observability profile 用；口令用 openssl rand -hex 32 生成）──
LANGFUSE_NEXTAUTH_SECRET=""
LANGFUSE_SALT=""
LANGFUSE_ENCRYPTION_KEY=""
LANGFUSE_REDIS_PASSWORD=""
CLICKHOUSE_USER=clickhouse
CLICKHOUSE_PASSWORD=""
MINIO_ROOT_USER=minio
MINIO_ROOT_PASSWORD=""
LANGFUSE_INIT_USER_EMAIL=dev@example.com
LANGFUSE_INIT_USER_PASSWORD=""

# 账号体系：JWT 签名密钥，本地随机生成；不进仓库，勿提交
JWT_SECRET=""

# ── 事件读路径（S1）：默认窗口的月数 ──
# 只影响 GET /api/v1/events 的缺省区间；显式 start/end 总是优先。
# 0 = 关闭默认窗口（两侧回无界，仍受 limit 约束）。
EVENTS_DEFAULT_WINDOW_MONTHS=12


# ── RAG 推理服务（S3）：独立进程，只绑 127.0.0.1 ──
# 空 = 进程内回滚；非空则 API/MCP 只调远程，不载模型
# RAG_SERVICE_URL=http://127.0.0.1:8200
# RAG_SERVICE_TOKEN=
# RAG_SERVICE_PORT=8200
# 生产建议开：冷启动首问会等服务加载
# RAG_PRELOAD=true
# RAG_EMBED_INFLIGHT=4
# RAG_RERANK_INFLIGHT=1
# RAG_INTERACTIVE_MAX_QUEUE=8
# RAG_INTERACTIVE_WAIT_SECONDS=0.5
# RAG_RESEARCH_MAX_QUEUE=32
# RAG_RESEARCH_WAIT_SECONDS=2.5
# RAG_BATCH_MAX_QUEUE=8
# RAG_BATCH_WAIT_SECONDS=600
# RAG_EMBED_WAIT_SECONDS=5

# ── 资源上限（S4）──
# PG：API 业务池 5s、checkpointer 30s（毫秒；0 = 不设置）
DB_STATEMENT_TIMEOUT_MS=5000
CHECKPOINT_STATEMENT_TIMEOUT_MS=30000
# DuckDB：每线程一条连接（每连接一个实例）；THREADS=0 / MEMORY_LIMIT 空 = 不设置
DUCKDB_THREADS=2
DUCKDB_MEMORY_LIMIT=1GB
# 进程级查询闸门：同时活跃的 DuckDB 查询数；0 = 关闭
DUCKDB_MAX_CONCURRENT=4

# ── 多 API worker（S5）：默认 1；2 时同时开共享限流 ──
# API_WORKERS=1
# RATE_LIMIT_SHARED=false
# 多进程指标目录由 scripts/dev.sh 在 API_WORKERS>1 时自动设置，不需要手工填
# PROMETHEUS_MULTIPROC_DIR=

# 基础设施区：
REDIS_COORD_HOST_PORT=6380
REDIS_COORD_URL="redis://127.0.0.1:6380/0"

# ── P4-S7 单机承压（RAG 合批 + worker 池）──
# 合批默认关（1）；门禁通过后改为验证过的 N（2–5）
RAG_RERANK_BATCH_MAX=1
RAG_RERANK_BATCH_WINDOW_MS=15
TASK_WORKER_POOL_ENABLED=true
TASK_WORKERS_BACKTEST=3
TASK_WORKERS_GRID=1
TASK_WORKERS_BATCH=1

# ── P4-S8 可观测性与缓存（METRICS_TOKEN / RAG_SERVICE_TOKEN 已有注释位）──
# monitoring 需要两个 token 均非空；dev.sh 写入 logs/ 供容器只读挂载
ALERT_HOOK_ENABLED=false
# 备份年龄指标的读取目录（与 install_backup_job.sh 同名）
# QS_BACKUP_DIR=~/QuantSageBackups

# P4-S9 数据层热点缓存（默认开；false = ST 名单/等权日表/窗口指纹全部直算）
BT_DATA_CACHE_ENABLED=true

